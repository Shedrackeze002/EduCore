# Copy to .env.local for local development against a Supabase project.
# Leave both empty to run the in-browser demo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: domain used for teacher-created student logins (username@domain).
# Must match STUDENT_EMAIL_DOMAIN on the create-students and send-emails functions.
VITE_STUDENT_EMAIL_DOMAIN=students.educore.local

# Repository where approved course requests become GitHub issues (owner/repo).
VITE_GITHUB_REPO=Shedrackeze002/EduCore
